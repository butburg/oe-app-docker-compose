APP_NAME="Weedy Gallery"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Berlin
APP_URL=http://localhost
ASSET_URL=http://localhost

VITE_APP_NAME=localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Not sync: the mail bundles wait in the jobs table until a worker sends them (locally the queue container).
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Mails to users (Weedy Gallery app settings, not part of the SMTP connection above) ---
# Announcements, comment and new image mails are not sent one by one but collected per user:
# the first item starts the clock, after MAIL_BUNDLE_MINUTES everything collected goes out as ONE mail.
# Default 60. Set e.g. 1 locally to see the mails in MailHog quickly.
MAIL_BUNDLE_MINUTES=60

# --- Image links (Weedy Gallery app settings) ---
# The app links uploaded images only via /img/{random id}/{token}, never via their file path.
# The token changes by itself every IMAGES_LINK_WINDOW_DAYS days; a copied image link works for 1 to 2
# such windows and then gives 404. Default 7.
IMAGES_LINK_WINDOW_DAYS=7

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false